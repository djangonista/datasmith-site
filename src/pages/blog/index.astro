---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && !data.unlisted);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Blog — DataSmith"
  description="Ręczna robota z danymi w biurze rachunkowym i to, jak ją zdejmuję. Razem z tym, co nie zadziałało."
>
  <div class="px-6 py-16">
    <div class="mx-auto max-w-5xl">
      <!-- Header -->
      <div class="mb-12">
        <span class="text-xs font-semibold uppercase tracking-widest text-[#B45309]">Blog</span>
        <h1 class="mt-2 text-4xl font-bold text-[#1C1917]">Robota na widoku</h1>
        <p class="mt-3 max-w-xl text-[#57534E]">
          Opisuję ręczną robotę z danymi i to, jak ją zdejmuję. Razem z tym, co nie zadziałało.
          Publikuję wtedy, kiedy jest co pokazać, nie według kalendarza.
        </p>
      </div>

      {posts.length === 0 ? (
        <div class="rounded border border-[#E7E5E4] bg-[#F5F5F4] p-12 text-center">
          <p class="font-mono text-[#57534E]">Wkrótce pierwsze wpisy.</p>
        </div>
      ) : (
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              slug={post.slug}
              tags={post.data.tags}
              image={post.data.image}
            />
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
