---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  image?: string;
  otherPosts?: { slug: string; data: { title: string; description: string; date: Date } }[];
}

const { title, description, date, tags = [], image, otherPosts = [] } = Astro.props;

const formattedDate = date.toLocaleDateString('pl-PL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": date.toISOString().split('T')[0],
  "dateModified": date.toISOString().split('T')[0],
  "author": {
    "@type": "Person",
    "@id": "https://datasmith.pl/#person",
    "name": "Paweł Kowalczyk",
    "url": "https://datasmith.pl",
  },
  "publisher": {
    "@type": "Person",
    "@id": "https://datasmith.pl/#person",
    "name": "Paweł Kowalczyk",
  },
  ...(image ? { "image": new URL(image, "https://datasmith.pl").href } : {}),
  ...(tags.length > 0 ? { "keywords": tags.join(", ") } : {}),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Strona główna", "item": "https://datasmith.pl" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://datasmith.pl/blog" },
    { "@type": "ListItem", "position": 3, "name": title },
  ],
};
---

<BaseLayout title={`${title} — DataSmith`} description={description} ogType="article">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <article class="px-6 py-16">
    <div class="mx-auto max-w-2xl">
      <!-- Back link -->
      <a href="/blog" class="mb-8 inline-flex items-center gap-2 font-mono text-sm text-[#57534E] hover:text-[#B45309]">
        ← Wszystkie wpisy
      </a>

      <!-- Header -->
      <header class="mb-10">
        <div class="mb-4 flex flex-wrap items-center gap-3">
          <time class="font-mono text-sm text-[#57534E]">{formattedDate}</time>
          {tags.map((tag) => (
            <span class="rounded bg-[#F5F5F4] px-2 py-0.5 font-mono text-xs text-[#57534E]">
              {tag}
            </span>
          ))}
        </div>
        <h1 class="text-3xl font-bold leading-tight text-[#1C1917] md:text-4xl">{title}</h1>
        <p class="mt-4 text-lg text-[#57534E]">{description}</p>
        {image && (
          <img
            src={image}
            alt={title}
            width="1376"
            height="768"
            loading="lazy"
            class="mt-8 w-full rounded border border-[#E7E5E4] object-cover"
          />
        )}
        <hr class="mt-8 border-[#E7E5E4]" />
      </header>

      <!-- Content -->
      <div class="prose prose-invert max-w-none
        prose-headings:font-bold prose-headings:text-[#1C1917]
        prose-p:text-[#57534E] prose-p:leading-relaxed
        prose-a:text-[#B45309] prose-a:no-underline hover:prose-a:underline
        prose-strong:text-[#1C1917]
        prose-code:font-mono prose-code:text-[#B45309] prose-code:bg-[#F5F5F4] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
        prose-pre:bg-[#F5F5F4] prose-pre:border prose-pre:border-[#E7E5E4] prose-pre:rounded
        prose-blockquote:border-l-[#B45309] prose-blockquote:text-[#57534E]
        prose-hr:border-[#E7E5E4]
        prose-li:text-[#57534E]
      ">
        <slot />
      </div>

      <!-- Footer -->
      <footer class="mt-16 border-t border-[#E7E5E4] pt-8">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <p class="font-mono text-sm text-[#57534E]">
            Masz podobny problem? <a href="/kontakt" class="text-[#B45309] hover:underline">Napisz do mnie →</a>
          </p>
          <a href="/blog" class="font-mono text-sm text-[#57534E] hover:text-[#B45309]">
            ← Więcej wpisów
          </a>
        </div>
      </footer>

      {otherPosts.length > 0 && (
        <section class="mt-12 border-t border-[#E7E5E4] pt-8">
          <h2 class="mb-6 font-mono text-xs text-[#B45309]">// przeczytaj też</h2>
          <div class="flex flex-col gap-4">
            {otherPosts.map((p) => (
              <a href={`/blog/${p.slug}`} class="group rounded border border-[#E7E5E4] bg-[#F5F5F4] p-4 transition-all hover:border-[#B45309]/30 hover:bg-[#FFFFFF]">
                <p class="font-mono text-sm font-semibold text-[#1C1917] group-hover:text-[#B45309]">{p.data.title}</p>
                <p class="mt-1 text-sm text-[#57534E] line-clamp-2">{p.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>
