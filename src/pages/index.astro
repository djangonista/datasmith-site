---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Kalkulator from '../components/Kalkulator.astro';
import BlogCard from '../components/BlogCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && !data.unlisted);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const faqs = [
  { question: "Ile to kosztuje?", answer: "Klasyfikator wyciągów: 800 zł za pierwszą firmę, 500 zł od drugiej do piątej, 350 zł od szóstej. Opieka miesięczna 60 zł za pierwszą firmę i 40 zł za każdą kolejną, z sufitem 350 zł miesięcznie niezależnie od liczby firm. Przypadki złożone, czyli wiele banków albo wyciągi walutowe: 1 200 do 1 500 zł. Pierwsza rozmowa, 30 minut, jest bezpłatna." },
  { question: "Czy to znaczy, że przestanę patrzeć na wyciąg?", answer: "Nie. Nadal patrzysz na wynik i nadal wpisujesz go sama. Znika przechodzenie pozycji i liczenie, nie kontrola. Nie księguję i nie wprowadzam niczego za Ciebie." },
  { question: "Pracuję w innym programie niż większość. To zadziała?", answer: "Tak, bo to dzieje się przed programem. Wynikiem jest kilka liczb, tyle ile masz kategorii, i te liczby i tak wpisujesz ręcznie w konkretne miejsce. Nie ma znaczenia, czy to Optima, Fakir, Symfonia czy arkusz." },
  { question: "Jak długo to trwa?", answer: "Pierwsza firma: 5 do 7 dni od przekazania przykładowego pliku. Każda kolejna: 2 do 3 dni, jeśli bank i format się powtarzają." },
  { question: "Co, jeśli bank zmieni układ pliku?", answer: "Poprawki są w cenie opieki miesięcznej. To się zdarza i jest wliczone." },
  { question: "Czy moje dane są bezpieczne?", answer: "Przetwarzanie odbywa się lokalnie, u Ciebie. Nie wysyłam plików na zewnętrzne serwery. Umowa o poufności przed przekazaniem czegokolwiek." },
  { question: "Masz referencje?", answer: "Uczciwie: mam jedno wdrożenie i jest opisane na tej stronie, z liczbami i bez nazwy klienta. Referencji imiennej jeszcze nie mam. Dla pierwszego klienta spoza kręgu znajomych mam ofertę pilotażową: niższa cena wdrożenia w zamian za pisemną referencję i zgodę na jawny opis." },
];

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://datasmith.pl/#website",
      "name": "DataSmith",
      "url": "https://datasmith.pl",
      "description": "DataSmith zdejmuje z biur rachunkowych ręczną robotę, która wraca co miesiąc. Rozliczanie wyciągów bankowych, listy płac przy nietypowych regulaminach.",
    },
    {
      "@type": "Person",
      "@id": "https://datasmith.pl/#person",
      "name": "Paweł Kowalczyk",
      "url": "https://datasmith.pl",
      "jobTitle": "Narzędzia dla biur rachunkowych",
      "description": "Szesnaście lat rozwiązywania problemów księgowych wewnątrz firmy produkcyjnej. Teraz buduje narzędzia dla biur rachunkowych: rozliczanie wyciągów, listy płac, mostki między systemami.",
      "email": "pawel@datasmith.pl",
      "knowsAbout": ["Rozliczanie wyciągów bankowych", "Listy płac", "Kursy NBP", "SQL Server", "Python"],
      "sameAs": [
        "https://www.linkedin.com/in/pawel-kowalczyk-ds",
        "https://x.com/plastyq",
        "https://github.com/djangonista",
      ],
    },
    {
      "@type": "Organization",
      "@id": "https://datasmith.pl/#organization",
      "name": "DataSmith",
      "url": "https://datasmith.pl",
      "description": "DataSmith buduje biurom rachunkowym narzędzia do roboty, która wraca co miesiąc. Rozliczanie wyciągów bankowych z podziałem na kategorie klienta i przeliczeniem walut po kursach NBP.",
      "founder": { "@id": "https://datasmith.pl/#person" },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "pawel@datasmith.pl",
        "contactType": "customer service",
        "availableLanguage": "Polish",
      },
      "areaServed": { "@type": "Country", "name": "PL" },
    },
    {
      "@type": "Service",
      "name": "Klasyfikator wyciągów bankowych",
      "description": "Wyciąg z banku wchodzi, gotowe sumy na kategorie wychodzą. Reguły przypisania ustalone raz, według podziału wydatków klienta. Kwoty w euro przeliczone po średnim kursie NBP z dnia poprzedzającego transakcję.",
      "provider": { "@id": "https://datasmith.pl/#person" },
      "areaServed": { "@type": "Country", "name": "PL" },
    },
    {
      "@type": "Service",
      "name": "Wyliczanie wynagrodzeń",
      "description": "Listy płac przy nietypowym regulaminie wynagradzania, którego standardowy program nie obsługuje. Logika w jednym miejscu, razem z dokumentacją, skąd wyszła każda kwota.",
      "provider": { "@id": "https://datasmith.pl/#person" },
      "areaServed": { "@type": "Country", "name": "PL" },
    },
    {
      "@type": "Service",
      "name": "Mostek między systemami",
      "description": "Bank wystawia plik w swoim formacie, a program go nie rozpoznaje. Tłumaczenie w obie strony, dopasowane do tego, czego oczekuje każda ze stron.",
      "provider": { "@id": "https://datasmith.pl/#person" },
      "areaServed": { "@type": "Country", "name": "PL" },
    },
    {
      "@type": "Service",
      "name": "Arkusze, których nikt nie rozumie",
      "description": "Arkusz odziedziczony po kimś, kto odszedł. Opisanie logiki, naprawa, kontrola wyniku. Zostaje to samo narzędzie, tylko przestaje być zagadką.",
      "provider": { "@id": "https://datasmith.pl/#person" },
      "areaServed": { "@type": "Country", "name": "PL" },
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": { "@type": "Answer", "text": faq.answer },
      })),
    },
  ],
};
---

<BaseLayout>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </Fragment>

  <!-- HERO (radar zachowany w komponencie) -->
  <Hero />

  <!-- PROBLEM -->
  <section id="problem" class="border-t border-[#E7E5E4] px-6 py-20">
    <div class="mx-auto max-w-2xl" data-animate>
      <span class="text-xs font-semibold uppercase tracking-widest text-[#B45309]">Problem</span>
      <h2 class="mt-2 mb-8 text-3xl font-bold text-[#1C1917]">
        To nie jest problem programu.<br>To dzieje się przed nim.
      </h2>
      <div class="space-y-4 text-sm leading-relaxed text-[#57534E]">
        <p>Wyciąg przychodzi jako surowa lista transakcji. Żeby cokolwiek z nim zrobić, ktoś musi przejść go pozycja po pozycji.</p>
        <p>Każdą transakcję trzeba przypisać do kategorii. Twojej, nie cudzej. Przy rachunku walutowym dochodzi drugi przebieg, bo bank podaje kwoty w euro i nie przelicza ich na złotówki.</p>
        <p>Na końcu wychodzi kilka liczb. Tyle, ile masz kategorii. I te kilka liczb ktoś wpisuje ręcznie w jedno miejsce.</p>
        <p><span class="font-semibold text-red-600">Trzy godziny miesięcznie</span> na jednej firmie. Co miesiąc to samo, od nowa.</p>
        <p>Dlatego to nie zależy od tego, w jakim programie pracujesz. Ta robota dzieje się <span class="text-[#1C1917]">zanim cokolwiek trafi do programu</span>: raz w głowie księgowej, drugi raz w arkuszu.</p>
        <p class="mt-2 text-base font-semibold text-[#1C1917]">Program nie decyduje, gdzie co należy. <span class="text-[#15803D]">To robi człowiek.</span></p>
      </div>
    </div>
  </section>

  <!-- SOLUTION -->
  <section id="solution" class="border-t border-[#E7E5E4] px-6 py-20">
    <div class="mx-auto max-w-2xl" data-animate>
      <span class="text-xs font-semibold uppercase tracking-widest text-[#B45309]">Rozwiązanie</span>
      <h2 class="mt-2 mb-10 text-3xl font-bold text-[#1C1917]">
        3 kroki. Na Twoich plikach.<br>Bez zmiany programu.
      </h2>
      <div class="space-y-8">
        <div class="flex gap-4">
          <div class="min-w-[2rem] text-right text-2xl font-bold text-[#B45309]">1.</div>
          <div>
            <h3 class="font-semibold text-[#1C1917]">Rozmowa <span class="font-normal text-[#57534E]">(30 minut, bezpłatna)</span></h3>
            <p class="mt-1 text-sm leading-relaxed text-[#57534E]">Która firma zjada Ci najwięcej czasu przy wyciągach, jaki ma bank i ile godzin miesięcznie na nią schodzi. Jeśli okaże się, że nie ma czego zdejmować, powiem to wprost.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="min-w-[2rem] text-right text-2xl font-bold text-[#B45309]">2.</div>
          <div>
            <h3 class="font-semibold text-[#1C1917]">Pierwsza firma <span class="font-normal text-[#57534E]">(5 do 7 dni)</span></h3>
            <p class="mt-1 text-sm leading-relaxed text-[#57534E]">Przekazujesz jeden przykładowy plik i mówisz, jak dzielisz wydatki. Resztę robię ja. Uruchamiam u Ciebie i sprawdzam na Twoich prawdziwych danych, porównując z tym, co dziś liczysz ręcznie.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="min-w-[2rem] text-right text-2xl font-bold text-[#B45309]">3.</div>
          <div>
            <h3 class="font-semibold text-[#1C1917]">Kolejne firmy <span class="font-normal text-[#57534E]">(2 do 3 dni każda)</span></h3>
            <p class="mt-1 text-sm leading-relaxed text-[#57534E]">Ty decydujesz, które i kiedy. Cena schodzi z każdą kolejną, a opieka ma sufit, więc powyżej ośmiu firm przestaje rosnąć.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section id="proof" class="border-t border-[#E7E5E4] px-6 py-20">
    <div class="mx-auto max-w-2xl" data-animate>
      <span class="text-xs font-semibold uppercase tracking-widest text-[#B45309]">Kto za tym stoi</span>
      <h2 class="mt-2 mb-10 text-3xl font-bold text-[#1C1917]">
        Szesnaście lat przy cudzych danych.<br>Wiem, jak wyglądają naprawdę.
      </h2>
      <div class="space-y-8 text-sm leading-relaxed">
        <div>
          <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-[#B45309]">Kim jestem</h3>
          <p class="text-[#57534E]">Paweł Kowalczyk. Od 2010 roku pilnuję systemów i danych w firmie produkcyjnej. Ale zlecenia przychodzą w większości od księgowości i kontrolingu: wysyłka faktur do KSeF, uzgodnienie magazynu z księgą, konsolidacja wynagrodzeń, e-Doręczenia, odtworzenie w bazie wartości środka trwałego. To nie jest nowa branża, tylko ta sama robota dla kogoś innego.</p>
        </div>
        <div>
          <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-[#B45309]">Czego nauczyło mnie ostatnie wdrożenie</h3>
          <p class="mb-2 text-[#57534E]">Do wersji, którą klientka uznała za swoją, poszły <span class="text-[#B45309]">cztery obroty i cztery uzgodnienia</span>. Żaden nie dotyczył poprawności liczenia. Wszystkie poszły na to, żeby wynik dało się przeczytać i sprawdzić.</p>
          <p class="font-medium text-[#1C1917]">Wynik musi być czytelny i weryfikowalny, nie tylko prawdziwy.</p>
        </div>
        <div>
          <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-[#B45309]">Czego nie robię</h3>
          <p class="text-[#57534E]">Nie jestem księgowym, nie mam uprawnień i nie doradzam podatkowo. Nie księguję i nie zastępuję weryfikacji. Nie obiecuję rewolucji. Znika przepisywanie i liczenie, nie kontrola. Nadal patrzysz na wynik i nadal wpisujesz go sama.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOMIK -->
  <section id="homik" class="border-t border-[#E7E5E4] px-6 py-20">
    <div class="mx-auto max-w-3xl" data-animate>
      <span class="text-xs font-semibold uppercase tracking-widest text-[#B45309]">Następny krok</span>
      <h2 class="mt-2 mb-4 text-center text-3xl font-bold text-[#1C1917]">Od czego zacząć?</h2>
      <p class="mb-12 text-center text-sm text-[#57534E]">Wybierz to co pasuje do Ciebie. Zero presji.</p>

      <!-- Quiz terminal -->
      <div id="quiz" class="mb-6">
        <h3 class="mb-2 text-center text-xl font-bold text-[#1C1917]">
          Ile kosztuje Cię ręczne rozliczanie
          <span class="bg-[#B45309] px-1 text-[#FAFAF9]">wyciągów</span>?
        </h3>
        <p class="mb-6 text-center text-sm text-[#57534E]">Cztery pytania. Wynik od razu, na miejscu. Nic nie wysyłam i nic nie zapisuję.</p>
        <Kalkulator />
      </div>

      <!-- Discovery -->
      <div class="my-12 rounded border border-[#E7E5E4] py-8 text-center">
        <p class="mb-4 text-sm text-[#57534E]">Wolisz porozmawiać? 30 minut o tym, która firma zjada Ci najwięcej czasu przy wyciągach.</p>
        <a href="/kontakt" class="inline-block rounded border border-[#B45309] px-6 py-3 text-sm font-semibold text-[#B45309] transition-colors hover:bg-[#B45309] hover:text-[#FAFAF9]">
          Umów discovery
        </a>
        <p class="mt-2 text-xs text-[#57534E]">Darmowe. Bez zobowiązań.</p>
      </div>

      <!-- Usługi -->
      <Services />

      <!-- Plan B -->
      <div class="mt-8 text-center">
        <p class="text-sm text-[#57534E]">Nie jesteś gotowy? Zero presji.</p>
        <a href="/blog" class="font-mono text-sm text-[#B45309] transition-colors hover:text-[#D97706]">
          Przeczytaj bloga &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="border-t border-[#E7E5E4] px-6 py-20">
    <div class="mx-auto max-w-2xl" data-animate>
      <span class="text-xs font-semibold uppercase tracking-widest text-[#B45309]">Pytania</span>
      <h2 class="mt-2 mb-10 text-center text-3xl font-bold text-[#1C1917]">
        Pytania, które zadajesz<br>zanim zdecydujesz
      </h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group border border-[#E7E5E4]">
            <summary class="cursor-pointer px-5 py-4 text-sm font-semibold text-[#1C1917] transition-colors hover:bg-[#F5F5F4]">
              {faq.question}
            </summary>
            <div class="px-5 pb-4 text-sm leading-relaxed text-[#57534E]">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
      <div class="mt-10 space-y-3 text-center">
        <p class="text-sm text-[#57534E]">Masz inne pytanie?</p>
        <p class="text-sm"><a href="mailto:pawel@datasmith.pl" class="text-[#B45309] hover:text-[#D97706]">pawel@datasmith.pl</a></p>
        <div class="pt-2">
          <a href="/kontakt" class="inline-block rounded bg-[#B45309] px-6 py-3 text-sm font-semibold text-[#FAFAF9] transition-colors hover:bg-[#D97706]">
            Umów 30-min discovery
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG (zachowany) -->
  {latestPosts.length > 0 && (
    <section id="blog" class="border-t border-[#E7E5E4] px-6 py-24">
      <div class="mx-auto max-w-5xl">
        <div class="mb-10 flex items-end justify-between">
          <div>
            <span class="text-xs font-semibold uppercase tracking-widest text-[#B45309]">Blog</span>
            <h2 class="mt-2 text-3xl font-bold text-[#1C1917]">Ostatnie wpisy</h2>
          </div>
          <a href="/blog" class="font-mono text-sm text-[#57534E] hover:text-[#B45309]">
            Wszystkie &rarr;
          </a>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {latestPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              slug={post.slug}
              tags={post.data.tags}
              image={post.data.image}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <Newsletter />
</BaseLayout>
