<section id="heroSection" class="relative overflow-hidden px-6 py-20 md:py-28">
  <!--
    Radar wyłączony 2026-08-21 przy zmianie pozycjonowania na biura rachunkowe.
    Powód: animowany radar z etykietami technicznymi to najmocniejszy sygnał
    „technologia i AI", a persona jest wobec takich obietnic sceptyczna.
    Kod rysujący zostaje niżej, zakomentowany, żeby dało się wrócić.
    <canvas id="radarCanvas" class="pointer-events-none absolute inset-0 h-full w-full"></canvas>
  -->

  <div class="relative z-10 mx-auto grid max-w-5xl items-start gap-12 lg:grid-cols-[1.15fr_1fr]">
    <!-- Kolumna lewa: przekaz -->
    <div>
      <!-- Label -->
      <div class="hero-item mb-6 inline-flex items-center gap-2 rounded-full border border-[#B45309]/25 bg-[#B45309]/8 px-3 py-1" style="--hero-delay: 0ms">
        <span class="h-1.5 w-1.5 rounded-full bg-[#B45309]"></span>
        <span class="text-xs font-medium text-[#B45309]">Dla biur rachunkowych</span>
      </div>

      <!-- Headline -->
      <h1 class="hero-item text-4xl font-bold leading-tight text-[#1C1917] md:text-5xl" style="--hero-delay: 80ms">
        <em class="not-italic text-[#B45309]">Wyciąg</em> z banku wchodzi.<br />
        Gotowe sumy wychodzą.
      </h1>

      <!-- Subheadline -->
      <p class="hero-item mt-6 text-lg leading-relaxed text-[#57534E]" style="--hero-delay: 160ms">
        Dla biur rachunkowych, w których ktoś co miesiąc przechodzi wyciąg pozycja po pozycji,
        przypisuje transakcje do kategorii i sumuje je ręcznie.
        Jedna firma potrafi zająć trzy godziny. Po wdrożeniu zajmuje osiem minut.
      </p>

      <!-- CTAs -->
      <div class="hero-item mt-8 flex flex-wrap items-center gap-4" style="--hero-delay: 280ms">
        <a
          href="#quiz"
          class="rounded bg-[#B45309] px-6 py-3 text-sm font-semibold text-[#FAFAF9] transition-all hover:bg-[#D97706]"
        >
          Policz, ile Cię to kosztuje
        </a>
        <a
          href="#problem"
          class="rounded border border-[#E7E5E4] px-6 py-3 text-sm font-medium text-[#57534E] transition-all hover:border-[#1C1917]/25 hover:text-[#1C1917]"
        >
          Jak to działa &darr;
        </a>
      </div>
    </div>

    <!-- Kolumna prawa: co wchodzi i co wychodzi. Zajmuje miejsce po radarze -->
    <div class="hero-item lg:mt-2" style="--hero-delay: 200ms">
      <div class="overflow-hidden rounded-lg border border-[#E7E5E4] bg-white shadow-sm">

        <!-- WEJŚCIE -->
        <div class="border-b border-[#E7E5E4] px-5 py-4">
          <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#57534E]">Wyciąg z banku</p>
          <div class="space-y-1.5 font-mono text-xs text-[#57534E]">
            <div class="flex justify-between gap-3"><span class="truncate">02.02 &nbsp;PRZELEW WYCH.</span><span class="shrink-0">-1 240,00</span></div>
            <div class="flex justify-between gap-3"><span class="truncate">03.02 &nbsp;ZAKUP KARTĄ</span><span class="shrink-0">-89,40</span></div>
            <div class="flex justify-between gap-3"><span class="truncate">03.02 &nbsp;PRZELEW EUR</span><span class="shrink-0">-450,00 &euro;</span></div>
            <div class="flex justify-between gap-3"><span class="truncate">04.02 &nbsp;OPŁATA</span><span class="shrink-0">-32,00</span></div>
            <div class="flex justify-between gap-3 opacity-45"><span class="truncate">05.02 &nbsp;PRZELEW WYCH.</span><span class="shrink-0">-2 100,00</span></div>
            <div class="flex justify-between gap-3 opacity-20"><span class="truncate">05.02 &nbsp;ZAKUP KARTĄ</span><span class="shrink-0">-214,90</span></div>
          </div>
          <p class="mt-3 text-xs text-[#57534E]">i jeszcze kilkaset pozycji</p>
        </div>

        <!-- PRZEJŚCIE -->
        <div class="flex items-center justify-center gap-3 bg-[#FAFAF9] py-2.5">
          <span id="flowArrow" class="text-lg text-[#B45309]">&darr;</span>
          <span class="text-xs font-semibold text-[#B45309]">8 minut</span>
        </div>

        <!-- WYJŚCIE -->
        <div class="border-t border-[#E7E5E4] px-5 py-4">
          <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#57534E]">Gotowe sumy na kategorie</p>
          <div id="sumsList" class="space-y-2 text-sm">
            <div class="sum-row flex justify-between gap-3"><span class="text-[#1C1917]">Materiały</span><span class="sum-val font-mono font-semibold text-[#1C1917]" data-sum="12480">12 480,00</span></div>
            <div class="sum-row flex justify-between gap-3"><span class="text-[#1C1917]">Usługi obce</span><span class="sum-val font-mono font-semibold text-[#1C1917]" data-sum="4310.5">4 310,50</span></div>
            <div class="sum-row flex justify-between gap-3"><span class="text-[#1C1917]">Wynagrodzenia</span><span class="sum-val font-mono font-semibold text-[#1C1917]" data-sum="28900">28 900,00</span></div>
            <div class="sum-row flex justify-between gap-3"><span class="text-[#1C1917]">Pozostałe</span><span class="sum-val font-mono font-semibold text-[#1C1917]" data-sum="612.3">612,30</span></div>
          </div>
          <p class="mt-3 text-xs text-[#57534E]">Kategorie są Twoje. Euro przeliczone po średnim kursie NBP.</p>
        </div>
      </div>

      <p class="mt-3 text-center text-xs text-[#57534E]">
        Przykład poglądowy. U klientki: <span class="font-semibold text-[#1C1917]">3 godziny miesięcznie na 8 minut</span>, zgodność z ręcznym arkuszem 100%.
      </p>
    </div>
  </div>
</section>

<style>
  /* ── Fade-in tekstu przy ładowaniu strony (stagger) ── */
  .hero-item {
    opacity: 0;
    transform: translateY(10px);
    animation: heroFadeUp 0.6s ease forwards;
    animation-delay: var(--hero-delay, 0ms);
  }

  @keyframes heroFadeUp {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Stats formatting (matching radar demo) ── */
  .stat-num {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .stat-desc {
    margin-top: 0.35rem;
    font-size: 0.8rem;
    line-height: 1.35;
    color: #57534E;
  }

  /* Badge dot blink */
  @keyframes blipBlink {
    0%, 100% { opacity: 1; box-shadow: 0 0 6px #B45309; }
    50%       { opacity: 0.3; box-shadow: none; }
  }
  .blip-dot { animation: blipBlink 2.4s ease-in-out infinite; }

  /* ── Sumy pojawiają się po policzeniu ── */
  .sums-pending .sum-row {
    opacity: 0;
    transform: translateY(4px);
  }
  .sums-run .sum-row {
    animation: sumIn 0.45s ease forwards;
  }
  .sums-run .sum-row:nth-child(1) { animation-delay: 0ms; }
  .sums-run .sum-row:nth-child(2) { animation-delay: 240ms; }
  .sums-run .sum-row:nth-child(3) { animation-delay: 480ms; }
  .sums-run .sum-row:nth-child(4) { animation-delay: 720ms; }

  @keyframes sumIn {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Strzałka pulsuje raz, w momencie liczenia */
  .arrow-run { animation: arrowNudge 0.9s ease-out 1; }
  @keyframes arrowNudge {
    0%   { transform: translateY(-3px); opacity: 0.4; }
    45%  { transform: translateY(2px);  opacity: 1; }
    100% { transform: translateY(0);    opacity: 1; }
  }

  /* Respektuj prefer-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-item { animation: none; opacity: 1; transform: none; }
    .blip-dot  { animation: none; }
    #radarCanvas { display: none; }
    .sums-pending .sum-row { opacity: 1; transform: none; }
    .sums-run .sum-row, .arrow-run { animation: none; }
  }
</style>

<script is:inline>
(function () {
  var list  = document.getElementById('sumsList');
  var arrow = document.getElementById('flowArrow');
  if (!list) return;

  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var vals   = Array.prototype.slice.call(list.querySelectorAll('.sum-val'));
  var fmt    = new Intl.NumberFormat('pl-PL', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  if (reduce) return;              // brak ruchu: zostaja gotowe liczby z HTML

  list.classList.add('sums-pending');
  vals.forEach(function (el) { el.textContent = '—'; });

  function countUp(el, target, delay) {
    var DUR = 1500;
    setTimeout(function () {
      var t0 = null;
      function step(ts) {
        if (t0 === null) t0 = ts;
        var p = Math.min(1, (ts - t0) / DUR);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt.format(target * eased);
        if (p < 1) requestAnimationFrame(step);
        else el.textContent = fmt.format(target);
      }
      requestAnimationFrame(step);
    }, delay);
  }

  function run() {
    list.classList.remove('sums-pending');
    list.classList.add('sums-run');
    if (arrow) arrow.classList.add('arrow-run');
    vals.forEach(function (el, i) {
      countUp(el, parseFloat(el.getAttribute('data-sum')), 240 * i);
    });
  }

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { io.disconnect(); setTimeout(run, 550); }
      });
    }, { threshold: 0.35 });
    io.observe(list);
  } else {
    run();
  }
})();
</script>

<!-- RADAR WYŁĄCZONY 2026-08-21. Kod zachowany, żeby dało się wrócić.
<script is:inline>
(function () {
  const SIGNAL_DEFS = [
    ['Wyciąg bankowy',     0.25, 0.38],
    ['Kategorie',          0.72, 0.58],
    ['Kurs NBP',           1.20, 0.44],
    ['Sumy na kategorie',  1.68, 0.70],
    ['Rozliczanie wyciągów', 2.20, 0.52],
    ['Listy płac',         2.75, 0.34],
    ['Zamknięcie miesiąca', 3.30, 0.65],
    ['Ręczne przepisywanie', 3.85, 0.28],
    ['Excel',              4.40, 0.56],
    ['Weryfikacja',        4.95, 0.76],
    ['Import',             5.50, 0.42],
    ['Mostek danych',      6.00, 0.62],
  ];

  const signals = SIGNAL_DEFS.map(([label, angle, baseDist]) => ({
    label, angle, baseDist,
    level: 0,
    maxLevel: 4 + Math.floor(Math.random() * 3),
    dist: baseDist,
    lit: 0,
    litMax: 130,
    fading: false,
    fadeAlpha: 1,
  }));

  const pulses = [];
  const canvas = document.getElementById('radarCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const heroEl = document.getElementById('heroSection');

  let W, H, CX, CY, R;

  function resize() {
    W = canvas.width  = heroEl.clientWidth;
    H = canvas.height = heroEl.clientHeight;
    // Radar centered in the right portion (text is left-aligned)
    CX = W * 0.72;
    CY = H * 0.50;
    R  = Math.hypot(Math.max(CX, W - CX), Math.max(CY, H - CY));
  }

  let sweepAngle = -Math.PI / 2;
  const SWEEP_SPEED = 0.008;
  const TRAIL = Math.PI * 0.55;
  let rotations = 0;

  function norm(a) { return ((a % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2); }
  function angDiff(sweep, sig) { return norm(norm(sweep) - norm(sig)); }
  function rgba(r, g, b, a) { return `rgba(${r},${g},${b},${a.toFixed(3)})`; }

  const AMBER  = [245, 158, 11];
  const AMBERL = [251, 191, 36];

  function blipXY(s) {
    const d = Math.min(s.dist, 0.92);
    const refR = Math.min(W, H) * 0.42;
    return {
      x: CX + Math.cos(s.angle) * d * refR,
      y: CY + Math.sin(s.angle) * d * refR,
    };
  }

  function onNewRotation() {
    signals.forEach(s => { if (s.level > 0) s.fading = true; });
    setTimeout(() => {
      signals.forEach(s => {
        if (s.fading) {
          s.lit = 0; s.fading = false; s.fadeAlpha = 1;
          s.level = (s.level + 1) % (s.maxLevel + 1);
          s.dist = s.baseDist + (s.level / s.maxLevel) * 0.18;
        }
      });
    }, 600);
  }

  function drawGrid() {
    const refR = Math.min(W, H) * 0.42;
    for (let i = 1; i <= 5; i++) {
      ctx.beginPath();
      ctx.arc(CX, CY, (i / 5) * refR, 0, Math.PI * 2);
      ctx.strokeStyle = rgba(...AMBER, 0.07);
      ctx.lineWidth = 1;
      ctx.stroke();
    }
    for (let i = 0; i < 8; i++) {
      const a = (i / 8) * Math.PI * 2;
      ctx.beginPath();
      ctx.moveTo(CX, CY);
      ctx.lineTo(CX + Math.cos(a) * R, CY + Math.sin(a) * R);
      ctx.strokeStyle = rgba(...AMBER, 0.04);
      ctx.lineWidth = 1;
      ctx.stroke();
    }
    for (let i = 0; i < 72; i++) {
      const a = (i / 72) * Math.PI * 2;
      const isMain = i % 9 === 0;
      const r0 = refR * (isMain ? 0.93 : 0.96);
      ctx.beginPath();
      ctx.moveTo(CX + Math.cos(a) * r0, CY + Math.sin(a) * r0);
      ctx.lineTo(CX + Math.cos(a) * refR, CY + Math.sin(a) * refR);
      ctx.strokeStyle = rgba(...AMBER, isMain ? 0.28 : 0.1);
      ctx.lineWidth = isMain ? 1.2 : 0.6;
      ctx.stroke();
    }
  }

  function drawSweep() {
    for (let i = 0; i < 80; i++) {
      const t  = i / 80;
      const t1 = (i + 1) / 80;
      const a0 = sweepAngle - TRAIL * (1 - t);
      const a1 = sweepAngle - TRAIL * (1 - t1);
      ctx.beginPath();
      ctx.moveTo(CX, CY);
      ctx.arc(CX, CY, R, a0, a1);
      ctx.closePath();
      ctx.fillStyle = rgba(...AMBER, t * t * 0.18);
      ctx.fill();
    }
    ctx.beginPath();
    ctx.moveTo(CX, CY);
    ctx.lineTo(CX + Math.cos(sweepAngle) * R, CY + Math.sin(sweepAngle) * R);
    const lg = ctx.createLinearGradient(
      CX, CY,
      CX + Math.cos(sweepAngle) * R, CY + Math.sin(sweepAngle) * R
    );
    lg.addColorStop(0,   rgba(...AMBERL, 0.9));
    lg.addColorStop(0.6, rgba(...AMBER,  0.5));
    lg.addColorStop(1,   rgba(...AMBER,  0));
    ctx.strokeStyle = lg;
    ctx.lineWidth = 1.8;
    ctx.shadowBlur = 12;
    ctx.shadowColor = rgba(...AMBER, 0.8);
    ctx.stroke();
    ctx.shadowBlur = 0;

    ctx.beginPath();
    ctx.arc(CX, CY, 4, 0, Math.PI * 2);
    ctx.fillStyle = rgba(...AMBERL, 1);
    ctx.shadowBlur = 14;
    ctx.shadowColor = rgba(...AMBER, 1);
    ctx.fill();
    ctx.shadowBlur = 0;
  }

  function drawBlips() {
    signals.forEach(s => {
      const diff = angDiff(sweepAngle, s.angle);
      if (diff < 0.07 && !s.fading) {
        s.lit = s.litMax;
        const { x, y } = blipXY(s);
        pulses.push({ x, y, r: 0, maxR: 28 + s.level * 6, t: 0 });
      }
      if (s.fading) s.fadeAlpha = Math.max(0, s.fadeAlpha - 0.018);
      if (s.lit <= 0 && !s.fading) return;

      const baseAlpha = s.fading ? s.fadeAlpha : Math.min(1, (s.lit / s.litMax) * 1.5);
      s.lit = Math.max(0, s.lit - 1);
      const { x, y } = blipXY(s);

      if (s.level > 0) {
        const arcSpan = (s.level / s.maxLevel) * Math.PI * 1.5;
        ctx.beginPath();
        ctx.arc(x, y, 14 + s.level * 2.5, -Math.PI / 2, -Math.PI / 2 + arcSpan);
        ctx.strokeStyle = rgba(...AMBER, baseAlpha * 0.55);
        ctx.lineWidth = 2;
        ctx.shadowBlur = 6;
        ctx.shadowColor = rgba(...AMBER, 0.4);
        ctx.stroke();
        ctx.shadowBlur = 0;
      }

      ctx.beginPath();
      ctx.arc(x, y, 8 + (1 - s.lit / s.litMax) * 18, 0, Math.PI * 2);
      ctx.strokeStyle = rgba(...AMBER, baseAlpha * 0.28);
      ctx.lineWidth = 1;
      ctx.stroke();

      const gr = ctx.createRadialGradient(x, y, 0, x, y, 20);
      gr.addColorStop(0, rgba(...AMBER, baseAlpha * 0.4));
      gr.addColorStop(1, rgba(...AMBER, 0));
      ctx.beginPath();
      ctx.arc(x, y, 20, 0, Math.PI * 2);
      ctx.fillStyle = gr;
      ctx.fill();

      const dotR = 3 + s.level * 0.8;
      ctx.beginPath();
      ctx.arc(x, y, dotR, 0, Math.PI * 2);
      ctx.fillStyle = rgba(...AMBERL, baseAlpha * 0.9);
      ctx.shadowBlur = 14;
      ctx.shadowColor = rgba(...AMBER, baseAlpha);
      ctx.fill();
      ctx.shadowBlur = 0;

      if (baseAlpha > 0.07) {
        const fs = Math.max(9, Math.min(12, W * 0.01));
        ctx.font = `400 ${fs}px 'JetBrains Mono', monospace`;
        const lx = x > CX ? x + dotR + 8 : x - dotR - 8;
        ctx.textAlign = x > CX ? 'left' : 'right';
        ctx.fillStyle = rgba(...AMBER, baseAlpha * 0.85);
        ctx.fillText(s.label, lx, y - 4);
        if (s.level > 0) {
          ctx.font = `300 ${Math.max(7, Math.min(9, W * 0.009))}px 'JetBrains Mono', monospace`;
          ctx.fillStyle = rgba(...AMBERL, baseAlpha * 0.6);
          ctx.fillText(`+${s.level}`, lx, y + 10);
        }
      }
    });
  }

  function drawPulses() {
    for (let i = pulses.length - 1; i >= 0; i--) {
      const p = pulses[i];
      p.t += 0.045;
      p.r = p.maxR * p.t;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.strokeStyle = rgba(...AMBER, (1 - p.t) * 0.5);
      ctx.lineWidth = 1.5;
      ctx.stroke();
      if (p.t >= 1) pulses.splice(i, 1);
    }
  }

  function frame() {
    ctx.clearRect(0, 0, W, H);
    drawGrid();
    drawSweep();
    drawBlips();
    drawPulses();

    const prev = sweepAngle;
    sweepAngle += SWEEP_SPEED;
    if (sweepAngle > Math.PI) sweepAngle -= Math.PI * 2;
    if (prev < 0 && sweepAngle >= 0) {
      rotations++;
      onNewRotation();
    }
    requestAnimationFrame(frame);
  }

  window.addEventListener('resize', resize);
  resize();
  frame();
})();
</script>
