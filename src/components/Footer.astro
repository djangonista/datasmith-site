---
import LogoMark from './LogoMark.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-[#E7E5E4] py-12">
  <div class="mx-auto max-w-5xl px-6">
    <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
      <!-- Brand -->
      <div>
        <a href="/" class="group inline-flex items-center gap-2.5 font-mono text-lg font-bold text-[#1C1917] hover:text-[#B45309]">
          <LogoMark size={22} class="text-[#B45309]" />
          <span>DataSmith<span class="text-[#B45309]">.pl</span></span>
        </a>
        <p class="mt-1.5 text-sm text-[#57534E]">
          Robota, która dzieje się zanim cokolwiek trafi do programu.
        </p>
      </div>

      <!-- Links -->
      <div class="flex items-center gap-6">
        <a
          href="https://www.linkedin.com/in/pawel-kowalczyk-ds"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-[#57534E] transition-colors hover:text-[#B45309]"
        >
          LinkedIn
        </a>
        <a
          href="https://x.com/plastyq"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-[#57534E] transition-colors hover:text-[#B45309]"
        >
          X / Twitter
        </a>
        <a
          href="https://github.com/djangonista"
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-[#57534E] transition-colors hover:text-[#B45309]"
        >
          GitHub
        </a>
        <a
          href="mailto:pawel@datasmith.pl"
          class="text-sm font-medium text-[#57534E] transition-colors hover:text-[#B45309]"
        >
          Email
        </a>
      </div>
    </div>

    <div class="mt-8 border-t border-[#E7E5E4] pt-6 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-xs text-[#57534E]">
        © {year} DataSmith. Paweł Kowalczyk. Wszelkie prawa zastrzeżone.
      </p>
      <div class="flex items-center gap-4">
        <a
          href="/polityka-prywatnosci"
          class="font-mono text-xs text-[#57534E] transition-colors hover:text-[#B45309]"
        >
          Polityka prywatności
        </a>
        <a
          id="footer-cookie-settings"
          href="#"
          class="font-mono text-xs text-[#57534E] transition-colors hover:text-[#B45309]"
        >
          Ustawienia cookies
        </a>
      </div>
    </div>
  </div>
</footer>
