---
import LogoMark from './LogoMark.astro';

const navLinks = [
  { href: '/#uslugi', label: 'Usługi' },
  // Realizacje zdjete 2026-08-21: sekcja nie jest renderowana na stronie glownej,
  // wiec link prowadzil donikad. Wraca razem z sekcja.
  { href: '/o-mnie', label: 'O mnie' },
  { href: '/blog', label: 'Blog' },
  { href: '/kontakt', label: 'Kontakt' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-[#E7E5E4] bg-[#FAFAF9]/90 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-2.5">
      <LogoMark size={22} class="text-[#B45309] transition-transform group-hover:scale-105" />
      <span class="font-mono text-lg font-bold text-[#1C1917] transition-colors group-hover:text-[#B45309]">
        DataSmith
      </span>
      <span class="font-mono text-xs text-[#B45309]">.pl</span>
    </a>

    <!-- Nav links -->
    <ul class="hidden items-center gap-6 md:flex">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="text-sm font-medium text-[#57534E] transition-colors hover:text-[#1C1917]"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA -->
    <a
      href="/kontakt"
      class="hidden rounded border border-[#B45309] px-4 py-1.5 text-sm font-semibold text-[#B45309] transition-all hover:bg-[#B45309] hover:text-[#FAFAF9] md:block"
    >
      Porozmawiajmy
    </a>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      class="flex flex-col gap-1.5 p-1 md:hidden"
      aria-label="Menu"
    >
      <span class="block h-0.5 w-6 bg-[#1C1917]"></span>
      <span class="block h-0.5 w-6 bg-[#1C1917]"></span>
      <span class="block h-0.5 w-4 bg-[#1C1917]"></span>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-[#E7E5E4] px-6 py-4 md:hidden">
    <ul class="flex flex-col gap-4">
      {navLinks.map(({ href, label }) => (
        <li>
          <a href={href} class="text-sm font-medium text-[#57534E] hover:text-[#1C1917]">
            {label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/kontakt"
          class="inline-block rounded border border-[#B45309] px-4 py-1.5 text-sm font-semibold text-[#B45309]"
        >
          Porozmawiajmy
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
