---
/**
 * LogoMark — znak firmowy: pozycje, kreska, suma.
 * Konwencja księgowa: wiersze, podkreślenie, wynik.
 *
 * Ten sam motyw wraca na banerze LinkedIna i na wszystkich grafikach wpisów.
 * Favikona używa monogramu D, bo przy 16 px litera jest rozpoznawalna,
 * a ten znak zaczyna się rozmywać. Patrz decyzja z 2026-08-24.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 22, class: cls = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class={cls}
>
  <rect x="3" y="4"  width="18" height="2"   rx="1"   fill="currentColor" opacity="0.42" />
  <rect x="3" y="9"  width="12" height="2"   rx="1"   fill="currentColor" opacity="0.42" />
  <rect x="2" y="14" width="20" height="1.6" rx="0.8" fill="currentColor" opacity="0.85" />
  <rect x="3" y="18" width="18" height="3.4" rx="1.7" fill="currentColor" />
</svg>
