---
---

<section id="newsletter" class="px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <div class="rounded border border-[#B45309]/20 bg-[#F5F5F4] p-8 md:p-12">
      <div class="mx-auto max-w-xl text-center">
        <span class="text-xs font-semibold uppercase tracking-widest text-[#B45309]">Biuletyn</span>
        <h2 class="mt-3 text-2xl font-bold text-[#1C1917] md:text-3xl">
          Bliżej Ideału
        </h2>
        <p class="mt-3 text-[#57534E]">
          Robota, która dzieje się, zanim cokolwiek trafi do programu, i o tym,
          jak przybliżyć ją do ideału. Dla właścicielek i właścicieli biur rachunkowych.
        </p>

        <form id="ac-form" class="mt-8 flex flex-col gap-3" novalidate>
          <input type="hidden" name="u" value="9" />
          <input type="hidden" name="f" value="9" />
          <input type="hidden" name="s" value="" />
          <input type="hidden" name="c" value="0" />
          <input type="hidden" name="m" value="0" />
          <input type="hidden" name="act" value="sub" />
          <input type="hidden" name="v" value="2" />
          <input type="hidden" name="or" value="c66d00cf-cfac-4660-8ee7-95d797e04447" />

          <div class="flex flex-col gap-3 sm:flex-row">
            <input
              type="text"
              name="firstname"
              placeholder="Imię"
              class="w-full rounded border border-[#E7E5E4] bg-[#FAFAF9] px-4 py-2.5 text-sm text-[#1C1917] placeholder-[#57534E] focus:border-[#B45309] focus:outline-none sm:w-36"
            />
            <input
              type="email"
              name="email"
              required
              placeholder="twój@email.pl"
              class="flex-1 rounded border border-[#E7E5E4] bg-[#FAFAF9] px-4 py-2.5 text-sm text-[#1C1917] placeholder-[#57534E] focus:border-[#B45309] focus:outline-none"
            />
            <button
              type="submit"
              id="ac-btn"
              class="rounded bg-[#B45309] px-6 py-2.5 text-sm font-semibold text-[#FAFAF9] transition-all hover:bg-[#D97706] disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Zapisz się
            </button>
          </div>
          <label class="flex items-start gap-2 text-left">
            <input
              type="checkbox"
              id="ac-consent"
              required
              class="mt-0.5 shrink-0 accent-[#B45309]"
            />
            <span class="text-xs text-[#57534E]">
              Chcę dostawać biuletyn „Bliżej Ideału” od Pawła Kowalczyka (DataSmith) na podany adres e-mail.
              Mogę się wypisać w każdej chwili. Zasady:
              <a href="/polityka-prywatnosci" class="text-[#B45309] underline hover:text-[#D97706]">polityka prywatności</a>.
            </span>
          </label>
          <p id="ac-error" class="hidden text-left text-xs text-[#B91C1C]" role="alert">
            Nie udało się zapisać. Spróbuj ponownie albo napisz na pawel@datasmith.pl.
          </p>
        </form>

        <div id="ac-success" class="mt-8 hidden">
          <p class="text-sm font-semibold text-[#B45309]">✓ Prawie gotowe.</p>
          <p class="mt-1 font-mono text-xs text-[#57534E]">Sprawdź skrzynkę i kliknij »Potwierdzam zapis«.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('ac-form') as HTMLFormElement;
  const btn = document.getElementById('ac-btn') as HTMLButtonElement;
  const successDiv = document.getElementById('ac-success') as HTMLDivElement;
  const errorP = document.getElementById('ac-error') as HTMLParagraphElement;
  let timeoutId: number | undefined;

  function showSuccess() {
    clearTimeout(timeoutId);
    form.style.display = 'none';
    successDiv.classList.remove('hidden');
  }

  function showError() {
    clearTimeout(timeoutId);
    btn.disabled = false;
    btn.textContent = 'Zapisz się';
    errorP.classList.remove('hidden');
  }

  // AC callbacks — called by server response JS
  (window as any)._show_thank_you = showSuccess;
  (window as any)._show_error = showError;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const emailInput = form.querySelector<HTMLInputElement>('[name="email"]')!;
    const consent = document.getElementById('ac-consent') as HTMLInputElement;
    if (!emailInput.value || !emailInput.value.includes('@')) {
      emailInput.focus();
      return;
    }
    if (!consent.checked) {
      consent.focus();
      return;
    }

    errorP.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Zapisuję...';

    const params: string[] = [];
    form.querySelectorAll('input').forEach((input) => {
      if (input.name) {
        params.push(encodeURIComponent(input.name) + '=' + encodeURIComponent(input.value));
      }
    });

    const script = document.createElement('script');
    script.onerror = showError;
    // Brak odpowiedzi AC w 15 s = błąd, nie sukces
    timeoutId = window.setTimeout(showError, 15000);
    script.src = `https://pawelkowalczyk.activehosted.com/proc.php?${params.join('&')}&jsonp=true`;
    document.head.appendChild(script);
  });
</script>
