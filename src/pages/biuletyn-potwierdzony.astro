---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Zapis potwierdzony — Bliżej Ideału"
  description="Zapis na biuletyn „Bliżej Ideału” potwierdzony."
>
  <meta slot="head" name="robots" content="noindex" />
  <div class="mx-auto max-w-xl px-6 py-32 text-center">
    <span class="text-xs font-semibold uppercase tracking-widest text-[#B45309]">Biuletyn</span>
    <h1 class="mt-3 text-2xl font-bold text-[#1C1917] md:text-3xl">
      Gotowe.<br />
      Jesteś na liście <span class="whitespace-nowrap">„Bliżej Ideału”.</span>
    </h1>
    <p class="mt-4 text-[#57534E]">
      Za chwilę przyjdzie mail powitalny z jednym pytaniem. Wystarczy odpisać jednym zdaniem.
    </p>
    <a href="/" class="mt-8 inline-block font-mono text-sm text-[#B45309] hover:text-[#D97706]">← wróć na stronę główną</a>
  </div>
</BaseLayout>
