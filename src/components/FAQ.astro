---
import { faqs } from '../data/faqs';
---

<section id="faq" class="px-6 py-24 border-t border-[#E7E5E4]">
  <div class="mx-auto max-w-3xl">
    <div class="mb-12">
      <span class="text-xs font-semibold uppercase tracking-widest text-[#B45309]">Faq</span>
      <h2 class="mt-2 text-3xl font-bold text-[#1C1917] md:text-4xl">
        Częste pytania
      </h2>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details
          data-animate
          class="group rounded border border-[#E7E5E4] bg-[#F5F5F4] transition-all hover:border-[#B45309]/30"
        >
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-mono text-sm font-semibold text-[#1C1917] [&::-webkit-details-marker]:hidden">
            {faq.question}
            <span class="shrink-0 text-[#B45309] transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="px-5 pb-5 text-sm leading-relaxed text-[#57534E]">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
